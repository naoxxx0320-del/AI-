---
/**
 * 全ページ共通の枠。head の共通部分・ヘッダー・申し込みボタン・フッターを持つ。
 * ページ固有の本文は slot、固有の head 要素は headExtra / jsonld で受け取る。
 */
import { SITE, NAV, FOOT_MENU, FOOT_ABOUT } from '../site';

export interface Og {
  type: string;
  title: string;
  description: string;
  url: string;
  image: string;
  /** 正方形の画像なら 'summary'（講師紹介など） */
  twitterCard?: 'summary' | 'summary_large_image';
}
export interface Props {
  title: string;
  description: string;
  /** 自分自身のパス。ナビの現在地表示に使う（例: "/courses.html"） */
  path: string;
  canonical?: string;
  robots?: string;
  og?: Og;
  /** 構造化データ（JSON文字列のまま渡す） */
  jsonld?: string[];
  /** ページ固有の <style> や <link rel="preload"> など */
  headExtra?: string;
  /** 申し込みページ自身では、申し込みへ誘うボタンの代わりに電話ボタンを出す */
  hideCta?: boolean;
}
const { title, description, path, canonical, robots, og, jsonld = [], headExtra = '', hideCta = false } =
  Astro.props;
const v = SITE.assetVersion;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{SITE.googleVerification.map((c) => <meta name="google-site-verification" content={c}>)}
<title>{title}</title>
<meta name="description" content={description}>
{robots && <meta name="robots" content={robots}>}
{canonical && <link rel="canonical" href={canonical}>}
{og && (
  <Fragment>
    <meta property="og:type" content={og.type}>
    <meta property="og:site_name" content={SITE.name}>
    <meta property="og:title" content={og.title}>
    <meta property="og:description" content={og.description}>
    <meta property="og:url" content={og.url}>
    <meta property="og:image" content={og.image}>
    <meta property="og:locale" content="ja_JP">
    <meta name="twitter:card" content={og.twitterCard ?? 'summary_large_image'}>
  </Fragment>
)}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512.png">
<link rel="apple-touch-icon" href="/assets/icon-180.png">
<link rel="stylesheet" href={`/assets/style.css?v=${v.css}`}>
<Fragment set:html={headExtra} />
{jsonld.map((j) => <script is:inline type="application/ld+json" set:html={j} />)}
</head>
<body>
<a class="skip" href="#main">本文へスキップ</a>

{!hideCta && (
  <Fragment>
    <a class="tab" href="/contact.html">体験のお申し込み</a>
    <nav class="bottombar" aria-label="お申し込み">
      <a class="c2" href={`tel:${SITE.tel}`}>お電話する</a>
      <a class="c1" href="/contact.html">体験を申し込む</a>
    </nav>
  </Fragment>
)}
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} ホーム`}>
      <svg class="brand-mark" width="44" height="44" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 2.6c5.1-1.4 9.6 1.1 12.6 4 3.3 3.2 6.4 5.6 7.7 10.2 1.3 4.7-.4 9.2-2.2 13.2-1.8 4-3.6 8.2-7.4 10.9-3.9 2.8-9 3.4-13.8 2.9-4.8-.5-9.6-2.2-12.7-5.8C5 34.4 4.2 29.2 4.4 24.3c.2-5 1.3-10.2 4.6-14C12.4 6.4 18.6 4.1 24 2.6Z" fill="var(--peach)"/>
        <text x="24" y="30" font-family="Noto Sans JP, sans-serif" font-size="16.5" font-weight="700" fill="var(--ink)" text-anchor="middle">AI</text>
      </svg>
      <span>
        <span class="brand-name">{SITE.name}</span>
        <span class="brand-sub">運営: {SITE.operator}</span>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="mainmenu">メニュー ☰</button>
    <nav class="menu" id="mainmenu" aria-label="メインメニュー">
      {NAV.map((n) => (
        <a href={n.href} class={n.mobileOnly ? 'only-mobile' : undefined}
           aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    {hideCta
      ? <a class="tel-btn" href={`tel:${SITE.tel}`}>お電話</a>  /* 申し込みページでは電話を出す */
      : <a class="tel-btn has-bottombar" href="/contact.html">お申し込み</a>}
  </div>
</header>

<main id="main">
<slot />
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">{SITE.name}</div>
        <p class="foot-tag">運営: {SITE.operator}<br>シニアのための、やさしいAI教室。<br>オンライン（全国）＆出張（墨田区・近隣）</p>
      </div>
      <nav aria-label="サイトマップ">
        <p class="foot-h">メニュー</p>
        <ul class="foot-links">
          {FOOT_MENU.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="会社情報">
        <p class="foot-h">運営</p>
        <ul class="foot-links">
          {FOOT_ABOUT.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li data-line-card hidden><a data-line-btn href="#" target="_blank" rel="noopener">LINEで相談する</a></li>
        </ul>
      </nav>
    </div>
    <div class="foot-bottom">
      © {SITE.operator}（{SITE.name}）<br>
      {SITE.notice}
    </div>
  </div>
</footer>

<script is:inline src={`/assets/config.js?v=${v.js}`} defer></script>
<script is:inline src={`/assets/site.js?v=${v.js}`} defer></script>
</body>
</html>
