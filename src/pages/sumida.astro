  "jsonld": [
    "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"ホーム\",\n          \"item\": \"https://sumida-ai.jp/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"墨田区でAIを学ぶ\",\n          \"item\": \"https://sumida-ai.jp/sumida.html\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"LocalBusiness\",\n      \"@id\": \"https://sumida-ai.jp/#localbusiness\",\n      \"name\": \"すみだAI教室\",\n      \"alternateName\": [\n        \"墨田区のAI教室\",\n        \"すみだAIきょうしつ\",\n        \"AIプロジェクトチーム\"\n      ],\n      \"description\": \"東京都墨田区を拠点に、シニア向けのAI・スマホ講座を出張とオンラインで行う教室。\",\n      \"url\": \"https://sumida-ai.jp/sumida.html\",\n      \"telephone\": \"+81-80-4885-5430\",\n      \"email\": \"naoxxx0320@gmail.com\",\n      \"priceRange\": \"500円〜9800円\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressRegion\": \"東京都\",\n        \"addressLocality\": \"墨田区\",\n        \"addressCountry\": \"JP\"\n      },\n      \"areaServed\": [\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都墨田区\"\n        },\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都江東区\"\n        },\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都台東区\"\n        },\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都葛飾区\"\n        },\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都江戸川区\"\n        }\n      ],\n      \"openingHoursSpecification\": [\n        {\n          \"@type\": \"OpeningHoursSpecification\",\n          \"dayOfWeek\": [\n            \"Monday\",\n            \"Tuesday\",\n            \"Wednesday\",\n            \"Thursday\",\n            \"Friday\",\n            \"Saturday\",\n            \"Sunday\"\n          ],\n          \"opens\": \"09:00\",\n          \"closes\": \"23:00\"\n        }\n      ],\n      \"knowsAbout\": [\n        \"生成AI\",\n        \"ChatGPT\",\n        \"スマートフォン\",\n        \"シニア向けデジタル教育\",\n        \"詐欺対策\"\n      ]\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"墨田区にシニア向けのAI教室はありますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"すみだAI教室が、墨田区を拠点にシニア・高齢者向けのAI講座を行っています。店舗は持たず、ご自宅や集会所への出張と、ご自宅で受けられるオンラインの2つの形で運営しています。墨田区内への出張は交通費をいただきません。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"墨田区のどこまで来てもらえますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"墨田区内は全域にうかがいます。押上・錦糸町・両国・曳舟・東向島・八広・京島・立花・文花など、区内であれば交通費はいただきません。近隣の江東区・台東区・葛飾区・江戸川区もご相談ください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"教室に通う必要はありますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"ありません。すみだAI教室は店舗を持たず、こちらからご自宅や集会所へうかがう出張型と、ご自宅で受けられるオンライン型の2つで運営しています。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"町会やシニアクラブで開いてもらえますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"はい。町会の集会所、シニアクラブ、介護施設などへの出張講座を承っています。人数や内容に応じてご相談ください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"墨田区以外に住んでいますが受けられますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"オンライン講座は全国どこからでも受けられます。出張は墨田区と近隣区が対象です。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"何歳くらいの方が受けていますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"年齢の制限は設けていません。60代から90代の方を想定して、文字の大きさ、進む速さ、言葉づかいを組み立てています。ご家族といっしょに受けていただくこともできます。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"スマホを持っていなくても受けられますか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"町会やシニアクラブへの出張講座では、貸出用のタブレットを持参しますので、お持ちでない方も参加できます。個別の講座については、まずお電話でご相談ください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"離れて暮らす親に受けさせたいのですが。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"ご家族からの代理のお申し込みを歓迎しています。オンライン講座は全国どこからでも受けられますので、親御さんが墨田区外にお住まいでも大丈夫です。ご希望があれば、進み具合をご家族へご報告します。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"パソコンは持っていませんが大丈夫ですか。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"大丈夫です。当教室の講座はすべてスマホ1台で受けられるように作っています。パソコンもタブレットもご用意いただく必要はありません。\"\n          }\n        }\n      ]\n    }\n  ]\n}"
  ],
