  "canonical": "https://sumida-ai.jp/online.html",
  "og": {
    "type": "article",
    "title": "シニア向けオンラインAI教室の受け方｜すみだAI教室",
    "description": "必要なのはスマホひとつ。初回は電話で接続を一緒にお手伝い。機械が苦手でも大丈夫です。",
    "url": "https://sumida-ai.jp/online.html",
    "image": "https://sumida-ai.jp/assets/og-image.png"
  },
  "jsonld": [
    "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"EducationalOrganization\",\n      \"@id\": \"https://sumida-ai.jp/#org\",\n      \"name\": \"すみだAI教室\",\n      \"alternateName\": [\n        \"AIプロジェクトチーム\",\n        \"墨田区のAI教室\"\n      ],\n      \"url\": \"https://sumida-ai.jp/\",\n      \"description\": \"シニア（高齢者）向けのオンライン・出張AI教室。専門用語を使わず、ゆっくり、何度でも教えます。\",\n      \"areaServed\": [\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都墨田区\"\n        }\n      ],\n      \"telephone\": \"+81-80-4885-5430\",\n      \"email\": \"naoxxx0320@gmail.com\"\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"ホーム\",\n          \"item\": \"https://sumida-ai.jp/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"オンラインのはじめ方\",\n          \"item\": \"https://sumida-ai.jp/online.html\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"HowTo\",\n      \"name\": \"シニアのためのオンライン講座のはじめ方\",\n      \"description\": \"スマホひとつで始められる、ビデオ通話でのオンライン受講の手順。初回は電話でのサポートつき。\",\n      \"step\": [\n        {\n          \"@type\": \"HowToStep\",\n          \"position\": 1,\n          \"name\": \"お申し込み\",\n          \"text\": \"電話またはフォームで体験を申し込みます。オンラインが初めてであることをお伝えください。\"\n        },\n        {\n          \"@type\": \"HowToStep\",\n          \"position\": 2,\n          \"name\": \"電話で接続の練習\",\n          \"text\": \"講座の前日までに、スタッフが電話で一緒にビデオ通話のつなぎ方を練習します。\"\n        },\n        {\n          \"@type\": \"HowToStep\",\n          \"position\": 3,\n          \"name\": \"当日、届いた案内を押すだけ\",\n          \"text\": \"講座の時間になったら、届いたメッセージの案内を押すだけで教室につながります。\"\n        }\n      ]\n    }\n  ]\n}"
  ],
  "path": "/online.html"
