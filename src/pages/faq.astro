---
import Base, { type Props } from '../layouts/Base.astro';
import body from '../bodies/faq.html?raw';

const meta = {
  "title": "AI・スマホ教室のよくある質問｜すみだAI教室",
  "description": "シニア向けAI教室のよくある質問。スマホだけで受講できる？オンラインが不安、料金や支払い方法、出張エリア、家族の代理申し込みなど、気になる点にお答えします。",
  "canonical": "https://sumida-ai.jp/faq.html",
  "og": {
    "type": "website",
    "title": "AI・スマホ教室のよくある質問｜すみだAI教室",
    "description": "スマホだけで受講できる？オンラインが不安…。シニア向けAI教室の気になる点にお答えします。",
    "url": "https://sumida-ai.jp/faq.html",
    "image": "https://sumida-ai.jp/assets/og-image.png"
  },
  "jsonld": [
    "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"EducationalOrganization\",\n      \"@id\": \"https://sumida-ai.jp/#org\",\n      \"name\": \"すみだAI教室\",\n      \"alternateName\": [\n        \"AIプロジェクトチーム\",\n        \"墨田区のAI教室\"\n      ],\n      \"url\": \"https://sumida-ai.jp/\",\n      \"description\": \"シニア（高齢者）向けのオンライン・出張AI教室。専門用語を使わず、ゆっくり、何度でも教えます。\",\n      \"areaServed\": [\n        {\n          \"@type\": \"AdministrativeArea\",\n          \"name\": \"東京都墨田区\"\n        }\n      ],\n      \"telephone\": \"+81-80-4885-5430\",\n      \"email\": \"naoxxx0320@gmail.com\"\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"ホーム\",\n          \"item\": \"https://sumida-ai.jp/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"よくある質問\",\n          \"item\": \"https://sumida-ai.jp/faq.html\"\n        }\n      ]\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"パソコンを持っていませんが、受講できますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"はい、スマートフォンだけで受講できます。タブレットでも大丈夫です。出張講座では貸出タブレットもご用意しています。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"オンラインのつなぎ方がわかりません。\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"初回は、講座の前日までにお電話で一緒に接続の練習をします。当日は届いた案内を押すだけです。つながらないときは、こちらからお電話して電話ごしに解決します。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"墨田区の外に住んでいても受講できますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"オンライン講座は全国どこからでも受講できます。出張講座は墨田区と近隣エリアが対象です。エリア外の場合もご相談ください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"AIをまったく知りませんが、ついていけますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"はい。当教室は主にAIを初めて触る方に向けた教室です。専門用語を使わず、身近な言葉でゆっくり進めます。同じ質問を何度していただいても大丈夫です。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"料金の支払い方法は？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"出張のときは当日その場で現金、またはPayPayでお支払いいただけます。オンライン講座は、メールでお送りする請求書からカードでお支払いいただけます。ご家族が代わりにお支払いいただくこともできます。カード番号をこちらからお電話でお聞きすることは決してありません。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"家族が代わりに申し込めますか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"はい、歓迎します。ご家族からの代理申し込み（受講のプレゼント）では、私たちから親御さんへやさしくご連絡し、ご希望によりご様子をご家族へご報告します。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"耳が遠いのですが、大丈夫でしょうか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"ゆっくり・はっきりお話しし、画面の文字も大きく表示します。マンツーマンでペースを合わせることもできますので、お申し込み時にお知らせください。\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"しつこい勧誘はありませんか？\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"ありません。体験後に無理におすすめすることは一切ありません。合わないと感じたら、そこで終わりにしていただいて大丈夫です。\"\n          }\n        }\n      ]\n    }\n  ]\n}"
  ],
  "path": "/faq.html"
} satisfies Props;
---
<Base {...meta}><Fragment set:html={body} /></Base>
